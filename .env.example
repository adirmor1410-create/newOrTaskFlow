# ==========================================
# גירה מדור אור - קובץ דוגמה להגדרות סביבה
# Jira Mador Or - Environment Variables Example
# ==========================================

# שם משתמש המחשב (OS Computer Username) של מנהל המערכת (Admin)
# ניתן להגדיר מספר מנהלים מופרדים בפסיקים (למשל: adir7,admin2)
VITE_ADMIN_USERNAME=adir7

# נתיב קובץ מסד הנתונים של המערכת (SQLite Database File)
# ניתן לציין נתיב יחסי או נתיב מלא במחשב (למשל: ./taskboard.db או C:\data\taskboard.db)
TASKBOARD_DATA_PATH=./taskboard.db
